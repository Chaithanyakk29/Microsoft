PORT=3001
NODE_ENV=development

# LLM Configuration
# Options for LLM_PROVIDER: "anthropic" | "openai" | "mock"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=

# Hindsight Operational Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_ENABLED=true
HINDSIGHT_BANK_ID=recall-ops-incidents

# Database
DATABASE_URL=file:./dev.db

# Security & CORS
JWT_SECRET=recall-ops-dev-secret-32-chars-min-ok
CORS_ORIGIN=http://localhost:5173

# Agent Settings
AGENT_MAX_ITERATIONS=15
AGENT_TIMEOUT_MS=300000
DEMO_MODE=false
